{
  "name": "jobfinder",
  "version": "0.1.0",
  "description": "Personal high-signal job search copilot",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter=./apps/* --parallel run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:worker": "pnpm --filter worker run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm --filter=./apps/* --parallel run build",
    "build:api": "pnpm --filter api run build",
    "build:worker": "pnpm --filter worker run build",
    "build:web": "pnpm --filter web run build",
    "start": "pnpm --filter api run start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "migrate": "pnpm --filter db run migrate",
    "migrate:gen": "pnpm --filter db run generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "clean": "pnpm --filter=./packages/* --filter=./apps/* run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  }
}
