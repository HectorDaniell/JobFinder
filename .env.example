# Copy this to .env and fill in your values
# DO NOT commit .env to git

# ============ DATABASE ============
DATABASE_URL="postgresql://jobfinder:localdev@localhost:5432/jobfinder"

# ============ REDIS ============
REDIS_URL="redis://localhost:6379"

# ============ ANTHROPIC (LLM RAZONAMIENTO) ============
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-v4-..."
# Desarrollo sin créditos: sustituye SOLO la llamada a Claude por un doble local.
# El resto del pipeline (perfil, bullets, generación de PDF/DOCX) sigue siendo real.
# Ponlo en "false" o bórralo cuando tengas la API key.
USE_FAKE_LLM="false"

# ============ VOYAGE AI (EMBEDDINGS) ============
# Get your API key from https://www.voyageai.com
VOYAGE_API_KEY="pa-..."

# ============ GOOGLE OAuth ============
# Configure in Google Cloud Console: https://console.cloud.google.com
# APIs: Gmail, Google Docs, Google Drive
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# ============ APP CONFIG ============
NODE_ENV="development"
API_PORT=3001
FRONTEND_PORT=3000

# ============ LLM COST CONTROL ============
# Daily budget in USD (set to 0 for unlimited)
LLM_DAILY_BUDGET_USD=5

# ============ LOGGING ============
# 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL="info"
